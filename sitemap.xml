---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for entry in site.pages %}
    {%- if entry.layout and entry.permalink and entry.sitemap != false %}
  <url><loc>{{ entry.url | absolute_url | xml_escape }}</loc></url>
    {%- endif %}
  {%- endfor %}
  {%- for post in site.posts %}
    {%- unless post.sitemap == false %}
  <url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>
    {%- endunless %}
  {%- endfor %}
  {%- for file in site.static_files %}
    {%- assign directory = file.path | split: '/' %}
    {%- if directory[1] == 'projects' and file.extname == '.html' %}
  <url><loc>{{ file.path | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc></url>
    {%- endif %}
  {%- endfor %}
</urlset>
